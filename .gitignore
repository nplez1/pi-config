# Local-only working state and any accidentally-added bulk.
.DS_Store
node_modules/
*.pre-pi-config-*
# Hand-made pre-change copies. Git history is the backup; these stay local.
*.bak-*
# Records which pi bundle chunk the model-picker patch last touched.
patches/.state.json

# Per-session runtime state, keyed by session id. Never shared, never committed.
.pi/subagent-schedules/
.pi/loops/

# pi-bolt build output and per-machine state (regenerated by rebuild.sh).
pi-bolt/*/dist-bun/
pi-bolt/*/build-info.json
pi-bolt/.pi-swap-state
pi-bolt/*/node_modules
